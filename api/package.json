{
  "name": "proispro-api",
  "version": "1.0.0",
  "private": true,
  "description": "proispro container API — thin REST glue between the StorageAdapter contract and Azure SQL (Fastify + TypeScript).",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
