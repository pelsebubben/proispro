{
  "name": "griplock",
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "migrate": "node server/migrate.mjs",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:staging": "playwright test --config playwright.staging.config.ts",
    "check": "tsc --noEmit && tsc --project tsconfig.tests.json",
    "docs:check": "node scripts/architecture-docs.mjs check",
    "docs:refresh": "node scripts/architecture-docs.mjs refresh",
    "docs:build": "node scripts/architecture-docs.mjs build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.26.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "yaml": "^2.9.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^24.19.2"
  }
}
