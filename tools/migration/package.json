{
  "name": "proispro-migration",
  "version": "1.0.0",
  "private": true,
  "description": "One-time Supabase (Postgres) -> Azure SQL migration tooling for proispro. Export every table to a Backup JSON, then import into Azure SQL stamping the Entra ownerId. Idempotent and verifiable.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "export": "tsx src/export.ts",
    "import": "tsx src/import.ts",
    "verify": "tsx src/verify.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.9",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
