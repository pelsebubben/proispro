{
  "name": "proispro",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "migrate": "node server/migrate.mjs",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:staging": "playwright test --config playwright.staging.config.ts",
    "check": "tsc --noEmit && tsc --project tsconfig.tests.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "yaml": "^2.8.1",
    "@playwright/test": "^1.60.0",
    "sharp": "^0.34.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "typescript": "^5.7.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^22.10.5"
  }
}
