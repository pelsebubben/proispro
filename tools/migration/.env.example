# =============================================================================
# proispro migration tooling — environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# =============================================================================

# --- Supabase (SOURCE), used by `npm run export` ----------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# A key that can READ every table. The service_role key is simplest for a
# one-time export (it bypasses RLS and reads ALL users' rows). Keep it secret.
# If you only need YOUR OWN rows you may instead use an anon key + a logged-in
# session, but service_role is the documented happy path for a full dump.
SUPABASE_KEY=

# --- Azure SQL (TARGET), used by `npm run import` and `npm run verify` -------
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=proispro
# Auth mode: "aad" (Entra, via @azure/identity DefaultAzureCredential) or "sql".
SQL_AUTH=aad

# Only when SQL_AUTH=sql:
SQL_USER=
SQL_PASSWORD=

# Optional connection tuning
SQL_PORT=1433
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERT=false
